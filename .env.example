# NightCheck — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit the .env file to version control.

# ─── Supabase (required) ───────────────────────────────────────────
# Your Supabase project URL (from Project Settings → API)
VITE_SUPABASE_URL=https://your-project.supabase.co

# Supabase anonymous/public key (safe to expose in client-side code)
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Supabase service role key (NEVER expose in client code; used by edge functions)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Supabase project reference ID
SUPABASE_PROJECT_REF=your-project-ref

# Supabase personal access token (for CLI operations)
SUPABASE_ACCESS_TOKEN=your-access-token-here

# ─── Encryption (recommended) ─────────────────────────────────────
# AES-256 master key for PII encryption (generate with: openssl rand -hex 32)
ENCRYPTION_MASTER_KEY=your-64-char-hex-key-here

# ─── WebAuthn (auto-detected if not set) ──────────────────────────
# The origin URL for WebAuthn (defaults to http://localhost:5173 in dev)
# WEBAUTHN_ORIGIN=https://your-app.vercel.app
# WEBAUTHN_RP_ID=your-app.vercel.app

# ─── SMS / OTP (optional) ────────────────────────────────────────
# Twilio credentials for SMS delivery. Without these, OTP codes are
# logged to the console instead of sent via SMS.
# TWILIO_ACCOUNT_SID=your-twilio-sid
# TWILIO_AUTH_TOKEN=your-twilio-token
# TWILIO_FROM_NUMBER=+1234567890

# ─── Development ─────────────────────────────────────────────────
# Set to "true" to echo OTP codes in API responses (for development only)
# OTP_ECHO=true

# ─── CORS ────────────────────────────────────────────────────────
# Restrict edge function CORS to your deployed domain in production
# ALLOWED_ORIGIN=https://your-app.vercel.app
